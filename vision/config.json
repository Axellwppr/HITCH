{
  "camera": {"helper": "build/capture_rgbd", "serial": "", "depth_height": 360},
  "head": {
    "port": "/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0",
    "baud": 1000000, "speed": 300, "acceleration": 10,
    "timeout_s": 8, "target_tolerance_deg": 2,
